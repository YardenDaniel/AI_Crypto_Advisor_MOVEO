
DATABASE_URL=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated browser origins allowed to send cookies.
# Local Vite app plus the production Vercel origin once it exists.
CORS_ORIGINS=http://localhost:5173

AUTH_COOKIE_NAME=access_token
# true on HTTPS (Railway production). SameSite=none requires Secure.
AUTH_COOKIE_SECURE=true
# none is required for cross-site Vercel → Railway cookie requests.
AUTH_COOKIE_SAMESITE=none

COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=your_coingecko_api_key

# Optional: not required for the current Market News implementation.
# Leave blank unless CryptoPanic is used as a news provider.
CRYPTOPANIC_BASE_URL=https://cryptopanic.com/api/developer/v2
CRYPTOPANIC_API_KEY=

REDDIT_MEME_URL=https://old.reddit.com/r/CryptoCurrencyMemes/top/?t=week
REDDIT_USER_AGENT=AI_Crypto_Advisor/1.0

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-oss-20b:free